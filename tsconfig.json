{
  "compilerOptions": {
    "module": "ES6",
    "target": "ES6",
    "moduleResolution": "bundler",
    "lib": ["DOM", "es2015", "esnext"],
    "types": ["node"],
    "noImplicitAny": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "outFile": "./dist/tsc.js",
    "sourceMap": true,
    "allowJs": true,
    "noEmit": true
  },
  "include": ["src/**/*"],
  "exclude": ["**/*.spec.ts"]
}